<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>VigilNetra Investigation Report — {{ ctx.incident_id }}</title>
<style>
  body { font-family: Helvetica, Arial, sans-serif; font-size: 11pt; color: #1a1a1a; margin: 2em; }
  h1 { font-size: 18pt; border-bottom: 2px solid #1F4E79; padding-bottom: 6px; }
  h2 { font-size: 13pt; color: #1F4E79; margin-top: 1.6em; }
  /* table-layout: fixed matters more than usual here — without it,
     xhtml2pdf (the Windows-dev fallback when WeasyPrint's native libs
     aren't installed) computes pathologically narrow columns for
     multi-column tables and wraps every cell one word per line. */
  table { width: 100%; border-collapse: collapse; margin-top: 0.5em; table-layout: fixed; }
  /* box-sizing: border-box matters here — without it, each cell's border
     and padding add on top of its percentage width instead of being
     included within it, and that adds up across a 6-7 column table into a
     real overflow past the page edge (verified: "Confidence" column
     header clipped in the rendered PDF). */
  th, td { box-sizing: border-box; border: 1px solid #ccc; padding: 6px 8px; text-align: left; font-size: 9.5pt; white-space: normal; word-wrap: break-word; }
  th { background: #DCE6F1; }
  .disclaimer { margin-top: 2em; padding: 10px; border: 1px solid #d99; background: #fff4f4; font-size: 9pt; }
  .gap-note { font-style: italic; color: #555; }
  .evidence-frame { display: inline-block; margin: 6px; text-align: center; }
  .evidence-frame img { max-width: 220px; border: 1px solid #999; }
  .confidence-high { color: #146c2e; }
  .confidence-medium { color: #8a6d00; }
  .confidence-low { color: #b3261e; }
  /* Claim cards, not a table, for the Event Timeline: xhtml2pdf (the
     Windows-dev fallback renderer) reliably breaks free-form sentences one
     word per line once a table column gets narrow — verified on real
     narrative output, not just short test strings; a fixed-width fix that
     worked for one clip's phrasing broke again on a longer one. A
     paragraph in a full-width block wraps correctly in every renderer;
     only ultra-narrow table cells are the problem, so the fix is to stop
     putting free text in one. */
  .claim-card { border: 1px solid #ccc; border-radius: 4px; padding: 10px 14px; margin: 0.6em 0; }
  .claim-header { font-size: 9pt; color: #555; margin-bottom: 6px; font-weight: bold; }
  .claim-card p { margin: 4px 0; font-size: 10pt; }
  .claim-card .label { font-weight: bold; color: #1F4E79; }
</style>
</head>
<body>
  <h1>VigilNetra Investigation Report</h1>
  <p>Incident: {{ ctx.incident_id }}</p>

  <h2>Executive Summary</h2>
  <p>{{ ctx.executive_summary }}</p>

  <h2>Event Timeline</h2>
  {% if ctx.event_timeline %}
  {% for claim in ctx.event_timeline %}
  <div class="claim-card">
    <div class="claim-header">
      {{ "%.1f"|format(claim.when_start_s) }}s&ndash;{{ "%.1f"|format(claim.when_end_s) }}s
      &middot; {{ claim.who }}
      &middot; confidence: <span class="confidence-{{ claim.confidence }}">{{ claim.confidence }}</span>
    </div>
    <p><span class="label">What:</span> {{ claim.what }}</p>
    <p><span class="label">Where:</span> {{ claim.where }}</p>
    <p><span class="label">How:</span> {{ claim.how }}</p>
  </div>
  {% endfor %}
  {% else %}
  <p class="gap-note">No timestamped event narrative is available for this report.</p>
  {% endif %}

  <h2>Vehicle Kinematics</h2>
  {% if ctx.kinematics %}
  <table>
    <tr>
      <th width="15%">Actor</th><th width="14%">Class</th>
      <th width="10%">Min (m/s)</th><th width="10%">Max (m/s)</th><th width="11%">Mean (m/s)</th>
      <th width="18%">Method</th><th width="14%">Confidence</th>
    </tr>
    {% for row in ctx.kinematics %}
    <tr>
      <td width="15%">{{ row.actor }}</td>
      <td width="14%">{{ row.class_name or "-" }}</td>
      <td width="10%">{{ "%.1f"|format(row.min_speed_mps) }}</td>
      <td width="10%">{{ "%.1f"|format(row.max_speed_mps) }}</td>
      <td width="11%">{{ "%.1f"|format(row.mean_speed_mps) }}</td>
      <td width="18%">{{ row.method }}</td>
      <td width="14%" class="confidence-{{ row.confidence }}">{{ row.confidence }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="gap-note">No kinematics data is available for this report.</p>
  {% endif %}

  <h2>Contributing Factors</h2>
  {% if ctx.contributing_factors %}
  <ul>{% for f in ctx.contributing_factors %}<li>{{ f }}</li>{% endfor %}</ul>
  {% else %}
  <p class="gap-note">No contributing factors were derived for this report.</p>
  {% endif %}

  <h2>Driver State Observations</h2>
  {% if ctx.driver_state_observations %}
  <ul>{% for o in ctx.driver_state_observations %}<li>{{ o }}</li>{% endfor %}</ul>
  {% else %}
  <p class="gap-note">{{ ctx.driver_state_note }}</p>
  {% endif %}

  <h2>Evidence Frames</h2>
  {% if ctx.evidence_frames %}
  <div>
    {% for frame in ctx.evidence_frames %}
    <div class="evidence-frame">
      <img src="{{ frame.image_path }}">
      <div>track {{ frame.track_id }} @ {{ "%.1f"|format(frame.timestamp_s) }}s</div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="gap-note">No evidence frames were extracted for this report.</p>
  {% endif %}

  <h2>Confidence Appendix</h2>
  {% if ctx.confidence_appendix %}
  <table>
    <tr><th width="52%">Claim</th><th width="16%">Confidence</th><th width="32%">Source module</th></tr>
    {% for entry in ctx.confidence_appendix %}
    <tr>
      <td width="52%">{{ entry.claim }}</td>
      <td width="16%" class="confidence-{{ entry.confidence }}">{{ entry.confidence }}</td>
      <td width="32%">{{ entry.source_module }}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p class="gap-note">No claims to map to confidence levels.</p>
  {% endif %}

  <div class="disclaimer">{{ ctx.disclaimer }}</div>
</body>
</html>
